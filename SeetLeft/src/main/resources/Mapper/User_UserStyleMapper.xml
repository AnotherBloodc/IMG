<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.SeetLeft.Mapper.TableS.User_UserStyleMapper">

    <!-- 定义结果映射 -->
    <resultMap id="UserWithStylesResultMap" type="com.example.SeetLeft.Entity.User">
        <id column="Id" property="id"/>
        <result column="Username" property="username"/>
        <result column="Password" property="password"/>
        <result column="Email" property="email"/>

        <!-- 一对多关联查询 -->
        <collection property="userStyle"
                    ofType="com.example.SeetLeft.Entity.UserStyle"
                    select="com.example.SeetLeft.Mapper.TableS.User_UserStyleMapper.selectById"
                    column="Id"/>
    </resultMap>

    <!-- 查询所有用户及其风格 -->
    <select id="SelectUser_UserStyle" resultMap="UserWithStylesResultMap">
        SELECT *
        FROM `Seetpro`.`User`
    </select>

</mapper>