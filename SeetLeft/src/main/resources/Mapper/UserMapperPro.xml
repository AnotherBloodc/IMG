<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.SeetLeft.Mapper.UserMapper">

    <insert id="insert">
        insert into `Seetpro`.`User`
        (`User`.`Username`, `User`.`Password`, `User`.`Email`)
        values (#{username}, #{password}, #{email})
    </insert>

    <update id="update">
        update `Seetpro`.`User`
        set `User`.`Username` = #{username},
            `User`.`Password` = #{password},
            `User`.`Email`    = #{email},
            `User`.`Effect`   = #{effect}
        where (`User`.`Id` = #{id})
    </update>

    <delete id="delete">
        update `Seetpro`.`User`
        set `User`.`Effect` = false
        where (`User`.`Id` = #{id})
    </delete>

    <select id="server" resultType="com.example.SeetLeft.Entity.User">
        select `User`.`Id`, `User`.`Username`, `User`.`Password`, `User`.`Email`, `User`.`Datetime`, `User`.`Effect`
        from `Seetpro`.`User`
        <where>
            Effect = 1
            <if test="username != null">
                and `User`.`Username` = #{username}
            </if>
            <if test="email != null">
                and `User`.`Email` = #{email}
            </if>
        </where>
    </select>

    <insert id="insertUS" parameterType="com.example.SeetLeft.Entity.UserStyle">
        insert into `Seetpro`.`User_Style`(`User_Style`.`Id`, `User_Style`.`Userid`, `User_Style`.`Name`)
        values (#{id}, #{userid}, #{name})
    </insert>

</mapper>